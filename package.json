{
  "name": "dogo",
  "version": "0.0.0",
  "private": true,
  "description": "DogO local-first personal assistant \u2014 services prototype",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "node scripts/check-layout.mjs",
    "typecheck": "pnpm --filter @dogo/services --filter @dogo/mobile --filter @dogo/web typecheck && pnpm --filter @dogo/dsh-plugin typecheck",
    "test:services": "pnpm --filter @dogo/services test",
    "dev:desktop": "pnpm --filter @dogo/desktop dev",
    "dev:web": "pnpm --filter @dogo/web dev",
    "build:desktop": "pnpm build:plugin && pnpm --filter @dogo/web build",
    "test:runtime": "pnpm test:plugin",
    "test:desktop": "pnpm build:plugin && pnpm --filter @dogo/desktop test",
    "dev:mobile": "pnpm --filter @dogo/mobile dev",
    "build:mobile": "pnpm --filter @dogo/mobile build",
    "test:mobile": "pnpm --filter @dogo/mobile --filter @dogo/hub-ui test",
    "build:apk": "pnpm --filter @dogo/mobile android:apk",
    "build:plugin": "pnpm --filter @dogo/dsh-plugin build",
    "test:plugin": "pnpm build:plugin && pnpm --filter @dogo/dsh-plugin test"
  }
}

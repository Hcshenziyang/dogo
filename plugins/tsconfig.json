{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": [
    "shared/**/*.ts",
    "vendor/**/*.ts",
    "devices/**/*.ts",
    "workspace/**/*.ts",
    "tests/**/*.ts",
    "types.d.ts"
  ]
}

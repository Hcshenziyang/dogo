{
  "name": "@dogo/services",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./sync": "./src/sync.ts",
    "./client": "./src/client.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "pnpm --filter @dogo/sync-client build && node src/main.ts",
    "sync": "pnpm --filter @dogo/sync-client build && node src/sync-cli.ts",
    "typecheck": "pnpm --filter @dogo/sync-client build && tsc --noEmit",
    "test": "pnpm --filter @dogo/sync-client build && node --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7",
    "@dogo/sync-client": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
